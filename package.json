    "typecheck": "tsc --noEmit",
    "build": "bb plugin build"
  },
  "files": [
    "dist/",
    "src/",
    "lib/",
    "*.ts",
    "*.tsx",
    "!*.test.ts",
    "!*.test.tsx",
    "!vitest.config.ts",
    "README.md",
    "PLUGIN_OVERVIEW.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "!dist/*.map"
